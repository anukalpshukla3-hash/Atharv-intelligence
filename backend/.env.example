# Copy to .env and fill in.
PORT=4000

# --- Supabase ---
# Project URL: https://app.supabase.com/project/<ref>/settings/api
SUPABASE_URL=https://your-project.supabase.co
# Service role key (SECRET — server only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Anon public key (safe to ship to the browser)
SUPABASE_ANON_KEY=your-anon-key

# --- JWT (issued to admin sessions from the browser) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=change-me

# Comma-separated list of allowed browser origins for socket.io CORS
CORS_ORIGINS=http://localhost:3000,https://atharvintelligence.com

# Storage bucket name for message attachments
STORAGE_BUCKET=attachments
